{
  "name": "jankovic-servis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/domain/**\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-lines=100 \"src/**/*.test.ts\"",
    "seed": "node scripts/seed.ts",
    "demo:snapshot": "node scripts/demo-snapshot.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
