# Kopiraj u .env.local i popuni. .env.local se nikad ne commituje.

# Heš lozinke servisa. Generiši: pnpm hash-password "tvoja-lozinka"
APP_PASSWORD_HASH=

# Nasumična tajna za potpis sesije (najmanje 32 znaka). Generiši:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Samo na Vercelu (lokalno ostavi prazno: baza je PGlite u .data/pglite, fotografije u .data/uploads) ---
# Supabase → Connect → Session pooler (port 5432), sa lozinkom baze umesto [YOUR-PASSWORD]
# DATABASE_URL=
# Supabase → Project Settings → Data API / API Keys
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
